# =================================================================
# Server
# =================================================================
NODE_ENV=development
PORT=3001
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# =================================================================
# 🔐 Authentication
# =================================================================
NEXTAUTH_URL=http://localhost:3000
WEBSITE_URL=http://localhost:3000
AUTH_TRUST_HOST=true
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
AUTH_SECRET=change-me-to-a-long-random-string

# Admin (fully separate JWT + sessions)
ADMIN_JWT_SECRET=change-me-to-another-long-random-string
ADMIN_JWT_EXPIRES_IN=2h
ADMIN_REFRESH_TOKEN_EXPIRES_IN=7d

# Super admin bootstrap (used by seed)
ADMIN_DEFAULT_USERNAME=superadmin
ADMIN_DEFAULT_PASSWORD=change-me

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# =================================================================
# 📧 Email Configuration
# =================================================================
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=
# Display name shown in the "From" field (optional, default: Fazlaka)
EMAIL_SENDER_NAME=Fazlaka
# Public logo URL used in the email header (optional; text wordmark used when empty)
EMAIL_LOGO_URL=

# =================================================================
# 📩 Contact Settings
# =================================================================
RECEIVER_EMAIL=
EMAIL_USER=
EMAIL_PASS=

# =================================================================
# 🔑 API Keys
# =================================================================
IMGBB_API_KEY=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# =================================================================
# 🗄️ Database
# =================================================================
DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require&pgbouncer=true&connection_limit=20

# =================================================================
# 📡 Pusher Credentials
# =================================================================
NEXT_PUBLIC_PUSHER_APP_KEY=
NEXT_PUBLIC_PUSHER_APP_CLUSTER=eu
PUSHER_APP_ID=
PUSHER_APP_SECRET=
PUSHER_USE_TLS=true

# =================================================================
# ⚡ Redis (Upstash)
# =================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =================================================================
# 🔔 VAPID Keys (Web Push)
# =================================================================
NEXT_PUBLIC_VAPID_KEY=
VAPID_PRIVATE_KEY=

# =================================================================
# 🔥 Firebase Cloud Messaging (FCM)
# =================================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# =================================================================
# 🏥 Health Check Thresholds
# =================================================================
MEMORY_HEAP_LIMIT_MB=512
MEMORY_RSS_LIMIT_MB=1024

# Slow query threshold in ms (development only, default: 200)
SLOW_QUERY_MS=200

# =================================================================
# 🤖 Telegram Bot (phone verification via @Fazlaka_Auth_bot)
# =================================================================
# Secret bot token from @BotFather — NEVER expose in the frontend
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Fazlaka_Auth_bot

# =================================================================
# 💳 Paymob
# =================================================================
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_IFRAME_ID=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# =================================================================
# Voice calls (mediasoup + Socket.IO signaling)
# =================================================================
# Master switch for the voice-call feature
CALLS_ENABLED=true
# Namespace served by the Socket.IO gateway (keep the leading slash)
CALLS_SIGNALING_PATH=/calls
# Override the signaling URL clients receive from GET /api/v1/calls/config.
# Leave empty to auto-derive from the incoming request (ws/wss + host).
# Example: CALLS_WS_URL=wss://api.example.com/calls
CALLS_WS_URL=
# ICE servers handed to WebRTC clients (production: use a TURN server for
# symmetric NATs / mobile networks). Use EITHER CALLS_TURN_URL+credentials
# OR a full JSON array via CALLS_ICE_SERVERS.
CALLS_TURN_URL=
CALLS_TURN_USERNAME=
CALLS_TURN_CREDENTIAL=
CALLS_ICE_SERVERS=[]
# Mediasoup workers + WebRTC transport tuning
MEDIASOUP_WORKERS=1
MEDIASOUP_LOG_LEVEL=warn
# Local interface mediasoup binds to. Set to the public interface on the
# server (e.g. 0.0.0.0) and MEDIASOUP_ANNOUNCED_IP to the public IPv4 when
# behind NAT (Docker/cloud) so candidates are reachable by clients.
MEDIASOUP_LISTEN_IP=127.0.0.1
MEDIASOUP_ANNOUNCED_IP=
# UDP/TCP port range opened on the firewall for WebRTC media
MEDIASOUP_RTC_MIN_PORT=20000
MEDIASOUP_RTC_MAX_PORT=20050
MEDIASOUP_OUTGOING_BITRATE=500000
MEDIASOUP_MAX_INCOMING_BITRATE=500000
